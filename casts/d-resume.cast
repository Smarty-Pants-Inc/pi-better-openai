[23.51786, "o", "\r\n\u001b]133;A\u0007\u001b[49m                                                                                                                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m \u001b[39mThe classifier is already selected with /openai-decisions. Call openai_decide exactly once with state {\"change\":\"README typo fix\",\"tests\":\"pass\"}    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m and questions: route (choice: review or proceed), ready (bool), risk (score 1-5). Then list the typed answers.                                       \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;B\u0007\u001b]133;C\u0007\u001b[49m                                                                                                                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m                                                                                                                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m \u001b[39m\u001b[1mopenai_decide\u001b[22m\u001b[39m \u001b[39m\u001b[2mstate={\"change\":\"README typo fix\",\"tests\":\"pass\"} questions={\"route\":{\"type\":\"choice\",\"instructio...\u001b[22;39m                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m \u001b[39m\u001b[2m{\"status\":\"ok\",\"provider\":\"openrouter\",\"model\":\"~typesafe/jev-latest\",\"answers\":{\"route\":{\"type\":\"choice\",\"choice\":\"proceed\",\"confidence\":0.97,\"prob \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m \u001b[2mabilities\":{\"review\":0.01,\"proceed\":0.99}},\"ready\":{\"type\":\"bool\",\"probability\":0.92},\"risk\":{\"type\":\"score\",\"score\":0,\"confidence\":1}}}\u001b[22;39m             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m                                                                                 