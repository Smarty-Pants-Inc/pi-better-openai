ructio...\u001b[22;39m                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[49m \u001b[39m\u001b[2m{\"status\":\"ok\",\"provider\":\"openrouter\",\"model\":\"~typesafe/jev-latest\",\"answers\":{\"route\":{\"type\":\"choice\",\"choice\":\"proceed\",\"confidence\":0.97,\"prob \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[49m \u001b[2mabilities\":{\"review\":0.01,\"proceed\":0.99}},\"ready\":{\"type\":\"bool\",\"probability\":0.92},\"risk\":{\"type\":\"score\",\"score\":0,\"confidence\":1}}}\u001b[22;39m             \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[49m                                                                                                                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K \u001b[38;5;5m- \u001b[39m\u001b[1mroute (choice):\u001b[22m \u001b[38;5;5mproceed\u001b[39m — confidence \u001b[38;5;5m0.97\u001b[39m.                                                                                                         \u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K \u001b[38;5;5m- \u001b[39m\u001b[1mready (bool):\u001b[22m probability of true \u001b[38;5;5m0.92\u001b[39m; no explicit boolean returned.                                                                              \u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K \u001b[38;5;5m- \u001b[39m\u001b[1mrisk (score 1–5):\u001b[22m returned \u001b[38;5;5m0\u001b[39m — outside the requested range; needs clarification before interpretation.                                             \u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K                                                                                                                                                      \u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2K These are classifier judgments, not authorization to act.                                                                                 