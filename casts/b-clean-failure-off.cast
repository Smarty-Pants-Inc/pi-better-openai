[30.068613, "o", "\u001b[?2026h\u001b[33;1H\u001b[2K/o\u001b[7m \u001b[0m                                                                                                                                                   \u001b[0m\u001b]8;;\u0007\u001b[33;3H\u001b[?25l\u001b[?2026l"]
[30.085159, "o", "\u001b[?2026h\u001b[35;1H\u001b[2K\u001b[38;5;5m→ openai-tier       [t] Select standard, fast, or ultrafast (API Astra; 6x Standard token prices)\u001b[39m                                                     \u001b[0m\u001b]8;;\u0007\u001b[36;1H\u001b[2K  openai-usage\u001b[39m\u001b[2m      [t] Show OpenAI subscription usage status\u001b[22;39m                                                                                         \u001b[0m\u001b]8;;\u0007\u001b[37;1H\u001b[2K  openai-resets\u001b[39m\u001b[2m     [t] Inspect and redeem Codex banked rate-limit resets\u001b[22;39m                                                                             \u001b[0m\u001b]8;;\u0007\u001b[38;1H\u001b[2K  openai-settings\u001b[39m\u001b[2m   [t] Open Better OpenAI settings picker\u001b[22;39m                                                                                            \u001b[0m\u001b]8;;\u0007\u001b[39;1H\u001b[2K  openai-image\u001b[39m\u001b[2m      [t] Generate an image with the standalone OpenAI Codex Images API\u001b[22;39m                                                                 \u001b[0m\u001b]8;;\u0007\u001b[40;1H\u001b[2K\u001b[39m\u001b[2m  (1/21)\u001b[22;39m                                                                                                                                              \u001b[0m\u001b]8;;\u0007\u001b[33;3H\u001b[?25l\u001b[?2026l"]
