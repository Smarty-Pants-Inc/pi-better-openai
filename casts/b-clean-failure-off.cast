[19.627829, "o", "\u001b[?2026h\u001b[32;1H\u001b[2K\u001b[38;5;4m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\u001b[33;1H\u001b[2K/\u001b[7m \u001b[0m                                                                                                                                                    \u001b[0m\u001b]8;;\u0007\u001b[34;1H\u001b[2K\u001b[38;5;4m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\u001b[35;1H\u001b[2K\u001b[38;5;5m→ settings          Open settings menu\u001b[39m                                                                                                                \u001b[0m\u001b]8;;\u0007\u001b[36;1H\u001b[2K  model\u001b[39m\u001b[2m             <provider/model> — Select model (opens selector UI)\u001b[22;39m                                                                               \u001b[0m\u001b]8;;\u0007\u001b[37;1H\u001b[2K  tree\u001b[39m\u001b[2m              Navigate session tree (switch branches)\u001b[22;39m                                                                                           \u001b[0m\u001b]8;;\u0007\u001b[38;1H\u001b[2K  thinking\u001b[39m\u001b[2m          <level> — Set thinking level\u001b[22;39m                                                                                                      \u001b[0m\u001b]8;;\u0007\u001b[39;1H\u001b[2K  scoped-models\u001b[39m\u001b[2m     Enable/disable models for Ctrl+P cycling\u001b[22;39m                                                                                          \u001b[0m\u001b]8;;\u0007\u001b[40;1H\u001b[2K\u001b[39m\u001b[2m  (1/33)\u001b[22;39m                                                                                                                          