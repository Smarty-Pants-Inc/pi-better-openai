9m                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[26;1H\u001b[2K\u001b[49m \u001b[39m\u001b[2m{\"status\":\"ok\",\"provider\":\"openrouter\",\"model\":\"~typesafe/jev-latest\",\"answers\":{\"route\":{\"type\":\"choice\",\"choice\":\"proceed\",\"confidence\":0.97,\"prob \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[27;1H\u001b[2K\u001b[49m \u001b[2mabilities\":{\"review\":0.01,\"proceed\":0.99}},\"ready\":{\"type\":\"bool\",\"probability\":0.92},\"risk\":{\"type\":\"score\",\"score\":0,\"confidence\":1}}}\u001b[22;39m             \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[28;1H\u001b[2K\u001b[49m                            "]
