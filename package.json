{
  "name": "@monotykamary/pi-better-openai",
  "version": "0.2.6",
  "description": "Improve OpenAI in pi with fast mode, usage stats, image generation, and footer polish.",
  "keywords": [
    "fast",
    "gpt",
    "image",
    "openai",
    "pi",
    "pi-extension",
    "pi-package",
    "priority",
    "service-tier"
  ],
  "homepage": "https://github.com/monotykamary/pi-better-openai#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-better-openai/issues"
  },
  "license": "MIT",
  "author": "monotykamary",
  "contributors": [
    {
      "name": "Matt Leong",
      "url": "https://github.com/mattleong"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-better-openai.git"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings index.ts src/*.ts src/*/*.ts tests/*.ts",
    "lint:fix": "oxlint --fix index.ts src/*.ts src/*/*.ts tests/*.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "~22.19.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "undici": "8.10.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
